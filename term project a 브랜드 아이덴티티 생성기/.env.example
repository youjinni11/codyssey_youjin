# 이 파일을 .env 로 복사한 뒤 실제 키를 넣으세요. (.env 는 GitHub 에 올리지 마세요!)

# 기본값: 텍스트(네이밍/슬로건/스토리/팔레트)와 로고 이미지 모두 OpenAI 를 사용합니다.
# 키 발급: https://platform.openai.com/api-keys  (이미지 생성은 유료 크레딧이 필요합니다)
OPENAI_API_KEY=여기에_OpenAI_키
# 선택: BRAND_TEXT_MODEL=gpt-4o-mini
# 선택: BRAND_OPENAI_IMAGE_MODEL=gpt-image-1-mini   BRAND_OPENAI_IMAGE_QUALITY=low  (DALL-E 후속 모델)

# ---- 코디세이 공개 API(교육기관 제공, /public-api-console 에서 발급)를 쓸 때만 ----
# 위 OPENAI_API_KEY 자리에 sk-cody-live-... 키를 넣고, 아래 두 줄의 주석을 지우세요.
# (이미지 엔드포인트 경로/응답 구조가 OpenAI 와 달라, Base URL 로 자동 판별해 처리합니다)
# OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# BRAND_TEXT_MODEL=gpt-5.4-mini

# ---- 다른 서비스로 바꾸고 싶을 때만 아래를 사용하세요 (선택 사항) ----

# 텍스트 생성을 Gemini 로 바꾸기: BRAND_TEXT_PROVIDER=gemini 로 설정하고 아래 키를 넣으세요.
# 키 발급: https://aistudio.google.com/apikey
# BRAND_TEXT_PROVIDER=gemini
# GEMINI_API_KEY=여기에_Gemini_키
# BRAND_TEXT_MODEL=gemini-3.6-flash

# 로고 이미지를 다른 서비스로 바꾸기: BRAND_IMAGE_PROVIDER=huggingface 또는 gemini
# huggingface: 무료 크레딧 있음, `pip3 install huggingface_hub` 필요, 토큰 발급: https://huggingface.co/settings/tokens
# BRAND_IMAGE_PROVIDER=huggingface
# HF_TOKEN=여기에_HF_토큰
# BRAND_HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# gemini: 무료 티어 없음(유료 티어 필요)
# BRAND_IMAGE_PROVIDER=gemini
# BRAND_IMAGE_MODEL=gemini-3.1-flash-image
