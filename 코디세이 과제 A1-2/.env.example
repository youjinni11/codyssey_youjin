# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤, 실제 키 값을 채워 넣으세요.
#   cp .env.example .env
#
# .env 파일은 .gitignore에 등록되어 있어 커밋되지 않습니다.
# 절대로 실제 키 값을 이 파일(.env.example)이나 README, 커밋에 직접 작성하지 마세요.

GEMINI_API_KEY="여기에_본인의_Gemini_API_키를_입력하세요"
KAKAO_REST_API_KEY="여기에_본인의_Kakao_REST_API_키를_입력하세요"

# 선택 사항: 사용할 Gemini 모델을 바꾸고 싶을 때만 설정 (기본값: gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"
